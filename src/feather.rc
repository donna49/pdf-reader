#include <windows.h>
#include "resource.h"

IDI_APP ICON "../assets/feather.ico"

1 24 "feather.manifest"

IDD_FIND DIALOGEX 0, 0, 250, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Find"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_FIND_TEXT, 7, 7, 236, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_FIND_STATUS, 7, 32, 100, 10
    PUSHBUTTON      "&Previous", IDC_FIND_PREV, 110, 30, 42, 15
    DEFPUSHBUTTON   "&Next", IDC_FIND_NEXT, 155, 30, 42, 15
    PUSHBUTTON      "Close", IDCANCEL, 201, 30, 42, 15
END

IDD_GOTO DIALOGEX 0, 0, 180, 52
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go to Page"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Page number:", IDC_GOTO_LABEL, 7, 9, 100, 10
    EDITTEXT        IDC_GOTO_EDIT, 110, 7, 63, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Go", IDOK, 77, 30, 46, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 127, 30, 46, 15
END

IDD_PASSWORD DIALOGEX 0, 0, 220, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password Required"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "This document is protected. Enter the password:", IDC_PASSWORD_LABEL, 7, 7, 206, 10
    EDITTEXT        IDC_PASSWORD_EDIT, 7, 20, 206, 14, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON   "OK", IDOK, 117, 40, 46, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 167, 40, 46, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "FeatherPDF - lightweight PDF reader"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "FeatherPDF"
            VALUE "OriginalFilename", "FeatherPDF.exe"
            VALUE "ProductName", "FeatherPDF"
            VALUE "ProductVersion", "1.0.0"
            VALUE "LegalCopyright", "AGPL-3.0 (uses MuPDF by Artifex Software)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
